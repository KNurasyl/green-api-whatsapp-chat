{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "routes": [
    {
      "src": "/.*",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    { "src": "/api/.*", "dest": "/api/index.ts" },
    { "handle": "filesystem" }
  ]
}
